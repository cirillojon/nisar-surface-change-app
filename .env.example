# =============================================================================
# NISAR Surface Change Explorer — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values for local development.
# In production, set these in the server's environment instead.

# ─── Flask ───────────────────────────────────────────────────────────────────
FLASK_ENV=development                # development | production
LOG_LEVEL=INFO

# ─── Database ────────────────────────────────────────────────────────────────
# Leave blank to use the bundled SQLite DB at <repo>/app-data/data.db
# (the app factory builds an absolute path automatically).
# Override with an absolute path or a postgres URL for production:
#   sqlite:////absolute/path/to/data.db
#   postgresql+psycopg://user:pw@host:5432/dbname
# NOTE: a *relative* sqlite URI like `sqlite:///app-data/data.db` is
# rewritten to an absolute path under the current working directory.
# DATABASE_URL (as set by hosted Postgres providers) is also honored when
# SQLALCHEMY_DATABASE_URI is blank; `postgres://` is rewritten to
# `postgresql://`. Postgres needs a driver: `pip install psycopg[binary]`.
SQLALCHEMY_DATABASE_URI=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins. REQUIRED in production.
# In development this defaults to localhost:5173 / 8880 if left blank.
ALLOWED_ORIGINS=

# ─── Data loader (bin/start) ─────────────────────────────────────────────────
# bin/start loads app/data/*.json into the DB on every boot. Set to 1 to skip.
SKIP_LOADER=0
# In `bin/start prod`, run the loader loop inside the web process
# instead of a separate `bin/start worker`.
RUN_INPROC_WORKER=0
# How often the loop re-runs the loader (hours).
LOADER_TTL_HOURS=24

# ─── NASA Earthdata Login ────────────────────────────────────────────
# Needed only to show SME2 (soil moisture) passes on the map: the backend
# reads those NISAR HDF5 files directly. Create a free account at
# https://urs.earthdata.nasa.gov, then "Generate Token" and paste it here.
# Without it, SME2 searches still work but passes can't be displayed.
# (A `machine urs.earthdata.nasa.gov` entry in ~/.netrc also works.)
EARTHDATA_TOKEN=

# ─── Rate limiting ───────────────────────────────────────────────────────────
# memory:// is fine for single-process dev. Use redis://… in production.
RATELIMIT_STORAGE_URI=memory://
# Set to false to disable rate limiting entirely (handy while hacking).
RATELIMIT_ENABLED=true

# ─── Boot escape hatch ───────────────────────────────────────────────────────
# Set to 1 to run `flask db upgrade` from inside create_app() at boot.
# Off by default — schema changes should be owned by `bin/start migrate`.
AUTO_UPGRADE_ON_BOOT=0

# ─── MCP server (on) and AI assistant (off) ───
# ENABLE_MCP=1 serves the read-only /api/tools registry that the MCP server
# (python -m mcp_server) wraps. No API key needed. Set 0 to hide it (and
# VITE_ENABLE_MCP=false in frontend/.env).
ENABLE_MCP=1
# Set ENABLE_AI=1 (and VITE_ENABLE_AI=true in frontend/.env) to turn on the
# "Ask AI" assistant at /api/assistant. It needs an Anthropic API key.
ENABLE_AI=0
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-sonnet-5-5   # any Claude model id
ASSISTANT_EFFORT=medium             # low | medium | high
ASSISTANT_DAILY_LIMIT=500           # requests per day, all users together

# Place search (/api/geocode). Defaults to OpenStreetMap's public Nominatim,
# which allows about one request a second; point this at a self-hosted
# Nominatim-compatible server for heavier use.
# GEOCODER_URL=https://nominatim.openstreetmap.org/search
