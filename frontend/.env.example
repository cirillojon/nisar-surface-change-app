# Copy to `frontend/.env` if you need to override the defaults.
# DO NOT commit `.env`.
#
# VITE_* values are baked into the production bundle and are visible to
# anyone who loads your site, so never put secrets in them.

# Backend URL.
# In dev: leave blank (Vite proxy uses VITE_PROXY_URL below).
# In prod: full URL of deployed backend, e.g. https://api.your-domain.com
VITE_API_BASE_URL=

# Dev-only: target for the /api proxy in `vite dev` server.
VITE_PROXY_URL=http://localhost:8880

# MCP server docs and the /api/tools reference are shown unless this is "false"
# (the backend's ENABLE_MCP controls the endpoint itself).
VITE_ENABLE_MCP=true
# The "Ask AI" assistant is hidden unless this is "true"
# (the backend needs ENABLE_AI=1 and an Anthropic key too).
VITE_ENABLE_AI=false
